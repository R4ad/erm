{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["risks", "follow_up_questions"],
  "properties": {
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["impact_id", "title", "initiating_factor", "realization_paths", "target_event",
                     "impact", "category", "confidence", "confidence_reason", "gaps"],
        "properties": {
          "impact_id": { "type": "string" },
          "title": { "type": "string", "maxLength": 120 },
          "initiating_factor": { "type": "string" },
          "realization_paths": {
            "type": "array", "minItems": 1,
            "items": { "type": "object", "additionalProperties": false, "required": ["path_id", "text"],
                       "properties": { "path_id": { "type": "string" }, "text": { "type": "string" } } }
          },
          "target_event": { "type": "object", "additionalProperties": false, "required": ["event_id", "text"],
                            "properties": { "event_id": { "type": "string" }, "text": { "type": "string" } } },
          "impact": { "type": "object", "additionalProperties": false, "required": ["text", "type", "scope"],
                      "properties": { "text": { "type": "string" }, "type": { "type": "string" }, "scope": { "type": "string" } } },
          "category": { "type": "string", "enum": ["{{ALLOWED_CATEGORIES}}"] },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "confidence_reason": { "type": "string" },
          "gaps": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "follow_up_questions": {
      "type": "array", "maxItems": 5,
      "items": { "type": "object", "additionalProperties": false, "required": ["question", "about", "reason"],
                 "properties": { "question": { "type": "string" }, "about": { "type": "string" }, "reason": { "type": "string" } } }
    }
  }
}
