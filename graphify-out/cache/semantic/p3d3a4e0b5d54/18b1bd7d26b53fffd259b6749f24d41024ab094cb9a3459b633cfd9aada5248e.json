{"nodes": [{"id": "design_system_erm_master", "label": "ERM Design System (MASTER)", "file_type": "document", "source_file": "design-system/erm/MASTER.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source of truth for the new ERM UI design system, designed from scratch and independently of the frontend/ folder; a per-page pages/<page>.md file overrides these rules."}, {"id": "design_system_erm_master_figma_design_file", "label": "ERM Figma Design File", "file_type": "concept", "source_file": "design-system/erm/MASTER.md", "source_location": "L4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pages: 00 Cover, 01 Design System, 02 Pages."}, {"id": "design_system_erm_master_design_direction", "label": "Design Direction (ui-ux-pro-max)", "file_type": "rationale", "source_file": "design-system/erm/MASTER.md", "source_location": "L7-12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Internal Persian RTL enterprise risk & compliance dashboard for daily desktop work; Banking/Traditional Finance and B2B Service profiles (rtl full); Accessible & Ethical + Minimalism & Swiss + Data-Dense Dashboard with mirrored charts and time axes; anti-patterns: playful design, purple/pink gradients, hiding credibility and decision authority, color alone for meaning."}, {"id": "design_system_erm_master_color_tokens", "label": "ERM / Color Tokens", "file_type": "concept", "source_file": "design-system/erm/MASTER.md", "source_location": "L14-25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Surface, sidebar, text, brand (#1E3A8A), gold accent, border and status token groups in Light mode."}, {"id": "design_system_erm_master_risk_level_colors", "label": "Risk Level Color Scale", "file_type": "rationale", "source_file": "design-system/erm/MASTER.md", "source_location": "L26-30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Low green, medium yellow, high orange, critical red, none grey; level colors belong to the method version and always come with a text label; impact severity 0-5 uses a monochrome brand ramp so it is not confused with risk level colors; risk level badge is a pill with a dot while workflow status badges have 4px corners."}, {"id": "design_system_erm_master_typography", "label": "Typography (Vazirmatn, IBM Plex Mono)", "file_type": "concept", "source_file": "design-system/erm/MASTER.md", "source_location": "L32-36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vazirmatn for all text and Persian digits, IBM Plex Mono for record codes (RK-, AS-, TR-, AC-, EV-, CT-); paragraphs starting with a Latin word are laid out LTR."}, {"id": "design_system_erm_master_spacing_radius_elevation", "label": "Spacing, Radius and Elevation Tokens", "file_type": "concept", "source_file": "design-system/erm/MASTER.md", "source_location": "L38-42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "space/1..10 = 4..40 for dashboard density; radius sm 4 to full 999; sparing elevation (Card, Popover, Focus Ring)."}, {"id": "design_system_erm_master_page_frame", "label": "Page Frame Layout", "file_type": "concept", "source_file": "design-system/erm/MASTER.md", "source_location": "L44-49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1440px desktop, 240px sidebar on the right edge, 56px topbar; nav groups follow the methodology stages with only the active group open; logical order runs right to left with the primary action at the left end."}, {"id": "design_system_erm_master_component_library", "label": "Component Library (01 Design System)", "file_type": "concept", "source_file": "design-system/erm/MASTER.md", "source_location": "L51-53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Button, Risk Level Badge, Risk Score Chip, Status Badge (7 tones), Nav Item, Avatar, Form Field, Choice, Tab, Sidebar, Topbar, 54 outline icons, logo mark."}, {"id": "design_system_erm_master_cross_page_ux_rules", "label": "Cross-Page UX Rules", "file_type": "rationale", "source_file": "design-system/erm/MASTER.md", "source_location": "L55-61", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Show only transitions and actions possible from the current state and role, explaining impossible ones; deadlines shown with their own unit and Solar Hijri date, overdue in red with a clock icon; labels always visible with errors under the field; charts directly labeled, right-to-left time axis, no sums or averages of ordinal scores; unknown, not recorded and zero shown distinctly in text."}, {"id": "design_system_erm_master_designed_pages_v1", "label": "Designed Pages v1", "file_type": "concept", "source_file": "design-system/erm/MASTER.md", "source_location": "L63-65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "My Work, Management Report, Risk Register, Risk File, Assessment File (QC), Impact Profile, Treatment Plan, Risk Acceptance (signer view), Risk Universe, Questionnaire Response."}], "edges": [{"source": "design_system_erm_master", "target": "design_system_erm_master_figma_design_file", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-system/erm/MASTER.md", "source_location": "L4", "weight": 1.0}, {"source": "design_system_erm_master", "target": "design_system_erm_master_design_direction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-system/erm/MASTER.md", "source_location": "L7-12", "weight": 1.0}, {"source": "design_system_erm_master", "target": "design_system_erm_master_color_tokens", "relation": "references", "confide