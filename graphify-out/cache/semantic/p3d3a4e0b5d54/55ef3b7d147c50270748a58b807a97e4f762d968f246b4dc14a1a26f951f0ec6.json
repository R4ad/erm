{"nodes": [{"id": "docs_risk_assessment_guide", "label": "Risk Assessment Items Guide", "file_type": "document", "source_file": "docs/risk-assessment-guide.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Describes each risk-assessment module item, its place in the declared method (section numbers refer to the method text) and current system behaviour; explicitly separates what the method requires from what is automated vs. left to assessor judgement."}, {"id": "docs_risk_assessment_guide_scenario_boundary", "label": "Scenario & Initiator Boundary (initiator / main event / consequence)", "file_type": "concept", "source_file": "docs/risk-assessment-guide.md", "source_location": "L51", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Initiator, main event and consequence must be kept distinct; each independent occurrence counted once, with a stated counting unit, out-of-count cases, observation period and coverage. Initiator definition must not change to reach a desired score; changing it forces A and B re-review. Each effect is credited in exactly one place (A, B0, E/Bc or impact)."}, {"id": "docs_risk_assessment_guide_assessment_kinds", "label": "Assessment Kinds (inherent, current, target)", "file_type": "concept", "source_file": "docs/risk-assessment-guide.md", "source_location": "L44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inherent assumes named excluded controls; current uses active controls and real evidence and drives priority/acceptance; target is a forecast with assumption, test criterion and due date. 'Post-action' is a fresh current assessment, not a fourth computational kind; promising a tool does not reduce the current result."}, {"id": "docs_risk_assessment_guide_assessment_horizon", "label": "Assessment Horizon (default 12 months)", "file_type": "concept", "source_file": "docs/risk-assessment-guide.md", "source_location": "L34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Likelihood time window; method version default is 12 months and a different horizon requires a stated reason before submission."}, {"id": "docs_risk_assessment_guide_overall_confidence", "label": "Overall Assessment Confidence", "file_type": "concept", "source_file": "docs/risk-assessment-guide.md", "source_location": "L42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One choice for the whole dossier, not per A/B0/dimension. Undetermined or incomplete results default to low confidence, which restricts normal acceptance; confidence does not replace reasons and evidence."}, {"id": "docs_risk_assessment_guide_scope_snapshot", "label": "Scope Snapshot at Approval", "file_type": "concept", "source_file": "docs/risk-assessment-guide.md", "source_location": "L40", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Service, customers, owner and scenario attributes are frozen at approval for historical reference; later control or data changes do not rewrite an approved result."}, {"id": "docs_risk_assessment_guide_impact_profile", "label": "Impact Profile (S/D/F/C/R per stakeholder)", "file_type": "concept", "source_file": "docs/risk-assessment-guide.md", "source_location": "L71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One column for Datin and each related bank, one row per dimension; each cell has level 0-5 or 'unknown', optional actual value/unit, financial basis (F only), reason and evidence. 'Unrecorded', 'unknown' (missing data with reason) and zero (no effect, with reason) are distinct; unknown is never replaced by zero and an all-zero profile is invalid. CIA labels map into S (availability) and D (confidentiality/integrity) without extra scores."}, {"id": "docs_risk_assessment_guide_impact_i", "label": "Impact I = max(S, D, F, C, R) across stakeholders", "file_type": "concept", "source_file": "docs/risk-assessment-guide.md", "source_location": "L87", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "I is the highest valid consequence across all dimensions and stakeholders; stays unknown while an unknown cell could raise it, unless a known level is already 5. Customer count alone adds no score; multi-bank simultaneity needs a documented common cause."}, {"id": "docs_risk_assessment_guide_service_dimension_s", "label": "S: Service & Continuity (RTO / MTPD)", "file_type": "concept", "source_file": "docs/risk-assessment-guide.md", "source_location": "L93", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Graded by disruption duration d relative to RTO and MTPD and service criticality; RTO must be positive and below MTPD, equality with MTPD is level 5. System only suggests S from duration and valid bounds; common cause, quality degradation and customer obligations are judged by the assessor. Method-owner approval for temporary S<4 is not yet structurally recorded."}, {"id": "docs_risk_assessment_guide_data_dimension_d", "label": "D: Data & Integrity", "file_type": "concept", "source_file": "docs/risk-assessment-guide.md", "source_location": "L108", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Confidentiality, integrity, privacy and output trustworthiness graded by data class, misuse potential, unique individuals and transaction effect; count thresholds are proposals pending security committee approval. Backups alone do not prove ledger reconstruction. Selected manually with reason and evidence; no automatic classification."}, {"id": "docs_risk_assessment_guide_financial_dimension_f", "label": "F: Financial (gross loss / approved 12-month revenue)", "file_type": "concept", "source_file": "docs/risk-assessment-guide.md", "source_location": "L123", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Credible gross loss of one scenario realisation divided by the stakeholder's own approved basis; insurance shown separately as net and decision basis stays gross until coverage is realised. Missing financial data is not zero. System suggests the level from amount and basis."}, {"id": "docs_risk_assessment_guide_compliance_dimension_c", "label": "C: Obligations & Compliance", "file_type": "concept", "source_file": "docs/risk-assessment-guide.md", "source_location": "L138", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Levels from internal procedure deviation up to service prohibition or licence loss; assessor must link contract clause, valid notice or legal opinion. Not extracted automatically from contracts; internal acceptance does not license a breach."}, {"id": "docs_risk_assessment_guide_reputation_dimension_r", "label": "R: Reputation & Customer Relationship", "file_type": "concept", "source_file": "docs/risk-assessment-guide.md", "source_location": "L151", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Levels from limited internal dissatisfaction to termination by a key customer; for future scenarios the predicted reaction must be supported by declared sensitivity, contract clause, verified similar experience or written relationship-owner opinion. Media speculation alone is insufficient."}, {"id": "docs_risk_assessment_guide_initiator_a", "label": "Initiator Rating A (annual rate or forward-looking evidence)", "file_type": "concept", "source_file": "docs/risk-assessment-guide.md", "source_location": "L164", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A is a 1-5 rank of initiator frequency/evidence within the horizon, not a final probability. Rate path uses count x 12 / observation months; rate data normally needs >=12 months and 95% coverage, and zero events in a year does not prove <0.1. New forms take a single level or unknown (no upper bound / separate A confidence by user request); legacy band data still readable by the engine."}, {"id": "docs_risk_assessment_guide_zero_event_a1_rule", "label": "Zero-Event 120-Month A1 Suggestion Rule", "file_type": "rationale", "source_file": "docs/risk-assessment-guide.md", "source_location": "L191", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Current software rule treats a 120-month zero-event period as sufficient to suggest A1; flagged as a software heuristic, not statistical proof or a substitute for data-adequacy review and expert judgement."}, {"id": "docs_risk_assessment_guide_realization_path", "label": "Realization Path (named step chain with preventive controls)", "file_type": "concept", "source_file": "docs/risk-assessment-guide.md", "source_location": "L193", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chain of steps from one initiator to the same main event; normal, direct and emergency paths may have different controls. A different initiator needs its own A and assessment. Paths are retired with evidence, never assigned zero."}, {"id": "docs_risk_assessment_guide_baseline_b0", "label": "Baseline Feasibility B0", "file_type": "concept", "source_file": "docs/risk-assessment-guide.md", "source_location": "L209", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Path feasibility without crediting assessed controls, 1-5 or unknown; B0=1 needs evidence of two very exceptional independent conditions; lack of path information never justifies B0=1."}, {"id": "docs_risk_assessment_guide_control_effectiveness_e", "label": "Control Effectiveness E", "file_type": "concept", "source_file": "docs/risk-assessment-guide.md", "source_location": "L219", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "E1 absent/unproven through E5 with failure/bypass testing and continuous monitoring. Existence, design adequacy, coverage and real performance are assessed separately; a good average does not offset an important failure. On fresh computation the system re-checks evidence validity, date, active state and E conditions and treats invalid controls as no reduction. Recovery controls may have E but E alone never lowers I."}, {"id": "docs_risk_assessment_guide_barrier_credit_bc", "label": "Barrier Credit Bc", "file_type": "concept", "source_file": "docs/risk-assessment-guide.md", "source_location": "L233", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Derived from valid E of selected controls, independence flag and open critical exception: 5 none proven, 4 at least one E2, 3 at least one E3 closing the essential step, 2 at least one E4/E5, 1 two independent E4/E5 barriers each stopping the path. Bc is not the mean of E nor 6-E; independence is not shown by different names or tools."}, {"id": "docs_risk_assessment_guide_path_and_scenario_b", "label": "B = min(B0, Bc) per path; scenario B = max over paths", "file_type": "concept", "source_file": "docs/risk-assessment-guide.md", "source_location": "L245", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A well-controlled path cannot compensate an open path: scenario B takes the worst (maximum) path B."}, {"id": "docs_risk_assessment_guide_e3_bc_conflict", "label": "Method Conflict: E3 as Bc=2 (\u00a717 example) vs Bc=3 (\u00a715 table)", "file_type": "rationale", "source_file": "docs/risk-assessment-guide.md", "source_location": "L252", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Code follows the explicit \u00a715 table; the \u00a717 numeric example therefore does not match code output."}, {"id": "docs_risk_assessment_guide_likelihood_l", "label": "Likelihood L (A x B lookup table)", "file_type": "concept", "source_file": "docs/risk-assessment-guide.md", "source_location": "L254", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "L comes only from the method-version table indexed by A row and B column; L1-L5 are ranks, not precise percentages."}, {"id": "docs_risk_assessment_guide_risk_score", "label": "Raw Risk Score = L x I (1-25)", "file_type": "concept", "source_file": "docs/risk-assessment-guide.md", "source_location": "L268", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Integer product for valid known L and I; controls are not re-applied in the product; base level bands low 1-4, medium 5-9, high 10-15, critical 16-25. Not editable in output."}, {"id": "docs_risk_assessment_guide_decision_level", "label": "Decision Level (after impact floor)", "file_type": "concept", "source_file": "docs/risk-assessment-guide.md", "source_location": "L274", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Level used for decisions after applying the impact floor and precedence rules; the raw product is never changed."}, {"id": "docs_risk_assessment_guide_precedence_rules", "label": "Precedence Rules (impact floor, active incident, binding prohibition, customer tolerance)", "file_type": "concept", "source_file": "docs/risk-assessment-guide.md", "source_location": "L300", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "I=5 forces at least high and I=4 at least medium; active incidents require critical priority and incident-management referral; binding prohibition yields critical and outside-acceptance-authority; exceeding customer tolerance limits general acceptance authority. Ties ordered by worse impact, customer reach, obligation proximity, then greater uncertainty."}, {"id": "docs_risk_assessment_guide_quality_review_workflow", "label": "Assessment Quality Review Workflow", "file_type": "concept", "source_file": "docs/risk-assessment-guide.md", "source_location": "L309", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "States draft, in quality review, referred to working group, approved; a different authorised reviewer (not the assessor) approves, returns or refers. Pre-submission and pre-approval checks cover owner, service, banks, assumptions, target due date, horizon reason, initiator boundary, A evidence, at least one path with B0 evidence, impact cells, reasons, positive-level evidence and engine input validity. Workflow is a system mechanism, not a new rank in the risk formula."}, {"id": "docs_risk_assessment_guide_acceptance_and_treatment", "label": "Risk Acceptance & Treatment (\u00a719 proposed authorities)", "file_type": "concept", "source_file": "docs/risk-assessment-guide.md", "source_location": "L317", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proposed authority, deadline and max acceptance validity per decision level (low 12 months ... critical 30 days with 24h containment). Low confidence, unknown constraints or incomplete critical impact are not normal acceptance; no automatic renewal; reminders 30 and 7 days before expiry. Acceptance is performed in the separate actions module; continuing/stopping a bank service remains a human decision."}, {"id": "docs_risk_assessment_guide_method_alignment_gaps", "label": "Open Gaps vs. Method (S<4 approval, financial fields, causal judgement, ranges, zero-event, E3 example, approval status)", "file_type": "rationale", "source_file": "docs/risk-assessment-guide.md", "source_location": "L332", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lists where implementation intentionally or provisionally diverges from the method text; scales, thresholds and proposed authorities are not equivalent to organisational approval or legal validity."}], "edges": [{"source": "docs_risk_assessment_guide_impact_profile", "target": "docs_risk_assessment_guide_impact_i", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/risk-assessment-guide.md", "source_location": "L85", "weight": 1.0}, {"source": "docs_risk_assessment_guide_service_dimension_s", "target": "docs_risk_assessment_guide_impact_profile", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/risk-assessment-guide.md", "source_location": null, "weight": 1.0}, {"source": "docs_risk_assessment_guide_data_dimension_d", "target": "docs_risk_assessment_guide_impact_profile", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/risk-assessment-guide.md", "source_location": null, "weight": 1.0}, {"source": "docs_risk_assessment_guide_financial_dimension_f", "target": "docs_risk_assessment_guide_impact_profile", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/risk-assessment-guide.md", "source_location": null, "weight": 1.0}, {"source": "docs_risk_assessment_guide_compliance_dimension_c", "target": "docs_risk_assessment_guide_impact_profile", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/risk-assessment-guide.md", "source_location": null, "weight": 1.0}, {"source": "docs_risk_assessment_guide_reputation_dimension_r", "target": "docs_risk_assessment_guide_impact_profile", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/risk-assessment-guide.md", "source_location": null, "weight": 1.0}, {"source": "docs_risk_assessment_guide_baseline_b0", "target": "docs_risk_assessment_guide_path_and_scenario_b", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/risk-assessment-guide.md", "source_location": "L246", "weight": 1.0}, {"source": "docs_risk_assessment_guide_barrier_credit_bc", "target": "docs_risk_assessment_guide_path_and_scenario_b", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/risk-assessment-guide.md", "source_location": "L246", "weight": 1.0}, {"source": "docs_risk_assessment_guide_control_effectiveness_e", "target": "docs_risk_assessment_guide_barrier_credit_bc", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/risk-assessment-guide.md", "source_location": "L243", "weight": 1.0}, {"source": "docs_risk_assessment_guide_realization_path", "target": "docs_risk_assessment_guide_baseline_b0", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/risk-assessment-guide.md", "source_location": "L203", "weight": 1.0}, {"source": "docs_risk_assessment_guide_initiator_a", "target": "docs_risk_assessment_guide_likelihood_l", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/risk-assessment-guide.md", "source_location": "L256", "weight": 1.0}, {"source": "docs_risk_assessment_guide_path_and_scenario_b", "target": "docs_risk_assessment_guide_likelihood_l", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/risk-assessment-guide.md", "source_location": "L256", "weight": 1.0}, {"source": "docs_risk_assessment_guide_likelihood_l", "target": "docs_risk_assessment_guide_risk_score", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/risk-assessment-guide.md", "source_location": "L269", "weight": 1.0}, {"source": "docs_risk_assessment_guide_impact_i", "target": "docs_risk_assessment_guide_risk_score", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/risk-assessment-guide.md", "source_location": "L269", "weight": 1.0}, {"source": "docs_risk_assessment_guide_risk_score", "target": "docs_risk_assessment_guide_decision_level", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/risk-assessment-guide.md", "source_location": "L272", "weight": 1.0}, {"source": "docs_risk_assessment_guide_precedence_rules", "target": "docs_risk_assessment_guide_decision_level", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/risk-assessment-guide.md", "source_location": "L302", "weight": 1.0}, {"source": "docs_risk_assessment_guide_e3_bc_conflict", "target": "docs_risk_assessment_guide_barrier_credit_bc", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/risk-assessment-guide.md", "source_location": "L252", "weight": 1.0}, {"source": "docs_risk_assessment_guide_zero_event_a1_rule", "target": "docs_risk_assessment_guide_initiator_a", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/risk-assessment-guide.md", "source_location": "L191", "weight": 1.0}, {"source": "docs_risk_assessment_guide_scenario_boundary", "target": "docs_risk_assessment_guide_initiator_a", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/risk-assessment-guide.md", "source_location": "L61", "weight": 1.0}, {"source": "docs_risk_assessment_guide_assessment_horizon", "target": "docs_risk_assessment_guide_initiator_a", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/risk-assessment-guide.md", "source_location": "L166", "weight": 1.0}, {"source": "docs_risk_assessment_guide_overall_confidence", "target": "docs_risk_assessment_guide_acceptance_and_treatment",