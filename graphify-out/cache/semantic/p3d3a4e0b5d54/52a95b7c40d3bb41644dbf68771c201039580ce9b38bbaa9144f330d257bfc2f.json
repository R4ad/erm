{"nodes": [{"id": "apps_assessments_templates_assessments_assessment_detail", "label": "assessment_detail.html (assessment case file)", "file_type": "code", "source_file": "apps/assessments/templates/assessments/assessment_detail.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_assessments_templates_assessments_assessment_detail_result_summary", "label": "Assessment result (L, I, L x I score, base and decision level, confidence)", "file_type": "concept", "source_file": "apps/assessments/templates/assessments/assessment_detail.html", "source_location": "L82-L117", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The result is computed live until approval and frozen on approval; when the score is a range, the decision is taken on its upper bound."}, {"id": "apps_assessments_templates_assessments_assessment_detail_escalation_precedence", "label": "Escalation precedence rule (ongoing incident, binding prohibition, customer tolerance exceeded)", "file_type": "concept", "source_file": "apps/assessments/templates/assessments/assessment_detail.html", "source_location": "L40-L49,L106-L111", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Escalation flags take precedence over the base level and must carry a rationale and evidence; the result panel lists escalation reasons."}, {"id": "apps_assessments_templates_assessments_assessment_detail_qc_review", "label": "Assessment quality-control review and security workgroup referral", "file_type": "concept", "source_file": "apps/assessments/templates/assessments/assessment_detail.html", "source_location": "L119-L173", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "QC is done by a different GRC member than the assessor (approve, return, or refer to the security workgroup). A workgroup decision is recorded by a workgroup member or another GRC member not party to the dispute. An approved assessment is locked and the next assessment is a new row."}, {"id": "apps_assessments_templates_assessments_assessment_detail_likelihood_model", "label": "Likelihood model (L from A x B table)", "file_type": "concept", "source_file": "apps/assessments/templates/assessments/assessment_detail.html", "source_location": "L175-L201", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scenario B is the largest B among realization paths, and L comes only from the method version's A x B table; problems, incomplete reasons and approval blockers are listed."}, {"id": "apps_assessments_templates_assessments_assessment_detail_initiator_a", "label": "Initiator factor A (rate basis: count, period, denominator, coverage)", "file_type": "concept", "source_file": "apps/assessments/templates/assessments/assessment_detail.html", "source_location": "L203-L227", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A is recorded with a basis; for the rate basis the unique initiator count over a period (with optional denominator and logging coverage) yields a system-suggested A level and insufficiency warnings; rationale and evidence are required."}, {"id": "apps_assessments_templates_assessments_assessment_detail_realization_paths", "label": "Realization paths (B0, preventive controls E, Bc, path B)", "file_type": "concept", "source_file": "apps/assessments/templates/assessments/assessment_detail.html", "source_location": "L229-L280", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each path has a base B0 with rationale, preventive controls with effectiveness E from control assessments, a controlled Bc and a resulting path B; independence of barriers and exceptions are documented."}, {"id": "apps_assessments_templates_assessments_assessment_detail_impact_profile", "label": "Impact profile (dimensions x stakeholders, I = max valid level)", "file_type": "concept", "source_file": "apps/assessments/templates/assessments/assessment_detail.html", "source_location": "L282-L333", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "I is the highest valid level across impact dimensions and stakeholders (the organisation plus affected banks). Zero means no effect and unknown is never filled with zero; unknown or unrecorded cells mean there is no defensible upper bound yet."}, {"id": "apps_assessments_templates_assessments_assessment_detail_incomplete_assessment", "label": "Incomplete assessment blocks normal acceptance", "file_type": "rationale", "source_file": "apps/assessments/templates/assessments/assessment_detail.html", "source_location": "L100-L105", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An incomplete assessment lists its reasons and blocks normal acceptance."}, {"id": "apps_assessments_templates_assessments_assessment_detail_acceptance_authority", "label": "Acceptance authority limits (out of authority / restricted)", "file_type": "concept", "source_file": "apps/assessments/templates/assessments/assessment_detail.html", "source_location": "L112-L116", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "apps_assessments_templates_assessments_assessment_detail", "target": "apps_assessments_templates_assessments_includes_level_badge", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/assessments/templates/assessments/assessment_detail.html", "source_location": "L93", "weight": 1.0}, {"source": "apps_assessments_templates_assessments_assessment_detail", "target": "apps_assessments_templates_assessments_assessment_detail_result_summary", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/assessments/templates/assessments/assessment_detail.htm