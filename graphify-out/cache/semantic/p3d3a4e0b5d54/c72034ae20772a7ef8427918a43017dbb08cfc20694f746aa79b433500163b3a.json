{"nodes": [{"id": "apps_methodology_templates_methodology_version_detail", "label": "methodology/version_detail.html (assessment method version page)", "file_type": "code", "source_file": "apps/methodology/templates/methodology/version_detail.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_methodology_templates_methodology_version_detail_paths_v5_likelihood", "label": "paths_v5 likelihood strategy", "file_type": "rationale", "source_file": "apps/methodology/templates/methodology/version_detail.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per path B = min(B0, Bc); scenario B = max over paths; L is read from the A x B table (v5 sections 15 and 17)."}, {"id": "apps_methodology_templates_methodology_version_detail_bc_lowest_rule", "label": "Bc rules: lowest matching Bc wins", "file_type": "rationale", "source_file": "apps/methodology/templates/methodology/version_detail.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If several Bc conditions hold, the smallest Bc is chosen; with none, the default is the largest level of the Bc scale."}, {"id": "apps_methodology_templates_methodology_version_detail_max_impact_strategy", "label": "Max impact strategy (I = max over dimensions)", "file_type": "rationale", "source_file": "apps/methodology/templates/methodology/version_detail.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Final impact is the largest valid level across impact dimensions and stakeholders, not a sum or average."}, {"id": "apps_methodology_templates_methodology_version_detail_risk_score_l_times_i", "label": "Risk score = L x I", "file_type": "rationale", "source_file": "apps/methodology/templates/methodology/version_detail.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Score is likelihood times impact; risk level bands map score ranges to decision levels."}, {"id": "apps_methodology_templates_methodology_version_detail_impact_floor", "label": "Impact floor on decision level", "file_type": "rationale", "source_file": "apps/methodology/templates/methodology/version_detail.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Impact at or above a floor's min_impact forces at least that floor's level regardless of score; matrix cells marked 'floor' were raised above the score-based level."}, {"id": "apps_methodology_templates_methodology_version_detail_trial_version_condition", "label": "Trial (unapproved) method version condition", "file_type": "rationale", "source_file": "apps/methodology/templates/methodology/version_detail.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per the v5 'organizational execution condition', an unapproved version is only used for trial assessments until promulgated and does not replace current approved authorities and commitments."}, {"id": "apps_methodology_templates_methodology_version_detail_solar_hijri_periods", "label": "Solar Hijri month periods for acceptance validity", "file_type": "rationale", "source_file": "apps/methodology/templates/methodology/version_detail.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Month-based deadlines use the Persian solar calendar, e.g. a 6-month acceptance from 10 Mehr is valid until 10 Farvardin."}], "edges": [{"source": "apps_methodology_templates_methodology_version_detail", "target": "apps_methodology_templates_methodology_version_detail_paths_v5_likelihood", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/m