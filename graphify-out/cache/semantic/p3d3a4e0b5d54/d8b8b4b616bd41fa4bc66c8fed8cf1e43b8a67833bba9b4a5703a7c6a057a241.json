{"nodes": [{"id": "apps_actions_templates_actions_action_detail", "label": "action_detail.html (treatment action detail)", "file_type": "code", "source_file": "apps/actions/templates/actions/action_detail.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_actions_templates_actions_action_detail_action_lifecycle", "label": "Treatment action lifecycle (planned, approved, ready, in_progress, verified)", "file_type": "concept", "source_file": "apps/actions/templates/actions/action_detail.html", "source_location": "L51-L79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A planned action becomes approved only when the risk owner approves the plan; progress is recorded only while the risk is in treatment execution, by the action owner and assignee, and the verifier confirms the deliverable. A verified action is closed (section 20) and its effect on the risk is seen through plan reassessment. Actions can depend on other actions and carry an effect mechanism, deliverable and acceptance criteria."}], "edges": [{"source": "apps_actions_templates_actions_action_detail", "target": "apps_actions_templates_actions_includes_action_status", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/actions/templates/actions/action_detail.html", "source_location": "L8", "weight": 1.0}, {"source": "apps_actions_templates_actions_action_detail", "target": "apps_actions_templates_actions_action_detail_action_lifecycle", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/actions/templates/actions/action_detail.html", "source_location": "L51-L79", "weight": 1.0}, {"source": "apps_actions_templates_actions_action_detail", "target": "apps_actions_templates_actions_plan_detail", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "apps/actions/temp