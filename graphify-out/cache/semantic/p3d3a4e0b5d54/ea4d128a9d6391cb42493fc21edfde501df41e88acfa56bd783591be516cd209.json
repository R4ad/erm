{"nodes": [{"id": "docs_v5_logic_changes", "label": "V5 Logic Change Report (Datin Risk Management v5)", "file_type": "document", "source_file": "docs/v5-logic-changes.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compares code at commit f73ea67 against the v5 Word document; the engine already implemented the v5 model (A, B0, Bc, B=min, L from AxB, I=max S/D/F/C/R, LxI, impact floor), so this was gap-filling, not a CIA-to-v5 conversion. Software does not perform organisational approval, authority assignment or field pilot."}, {"id": "docs_v5_logic_changes_datin_risk_management_v5_document", "label": "Datin Risk Management Document v5 (\u0645\u062f\u06cc\u0631\u06cc\u062a-\u0631\u06cc\u0633\u06a9-\u062f\u0627\u062a\u06cc\u0646-v5.docx)", "file_type": "document", "source_file": "docs/v5-logic-changes.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reference source dated 12 Mehr 1405, SHA-256 c6c7cc34...; self-described as 'proposed for approval'."}, {"id": "docs_v5_logic_changes_e2_proven_limited_effect", "label": "E2 Requires Proven Limited Effect", "file_type": "concept", "source_file": "docs/v5-logic-changes.md", "source_location": "L34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Previously control existence, execution evidence and test date could suffice; now real limited effect must be proven with method, result and sample reason. Installation alone gives no reduction credit; legacy E2 without proof gets no credit on fresh computation (no automatic numeric conversion)."}, {"id": "docs_v5_logic_changes_control_credit_revalidation", "label": "Control Credit Revalidation at Computation (fallback to E1)", "file_type": "concept", "source_file": "docs/v5-logic-changes.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "E conditions are re-checked on computation; removed evidence, inactive control, future-dated test or lost conditions drop computational credit to E1 and Bc is recomputed from remaining valid barriers. Previously approved scores are not rewritten."}, {"id": "docs_v5_logic_changes_normal_assessment_delegated_approval", "label": "Delegated Approval of Normal Assessments", "file_type": "concept", "source_file": "docs/v5-logic-changes.md", "source_location": "L36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An authorised representative can approve normal dossiers; disagreements still require decision text and working-group meeting date."}, {"id": "docs_v5_logic_changes_horizon_reason_required", "label": "Different-Horizon Reason Required at Approval", "file_type": "concept", "source_file": "docs/v5-logic-changes.md", "source_location": "L37", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_v5_logic_changes_target_due_date", "label": "Mandatory Target Realization Due Date", "file_type": "concept", "source_file": "docs/v5-logic-changes.md", "source_location": "L38", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_v5_logic_changes_scope_preservation", "label": "Scope Preservation at Approval", "file_type": "concept", "source_file": "docs/v5-logic-changes.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Service, customers, owner, category, description, scope, initiator, counting unit and horizon are recorded at approval and the recorded scope is displayed; impact-profile customer columns of approved assessments also come from this snapshot. No synthetic snapshots for legacy assessments."}, {"id": "docs_v5_logic_changes_admin_panel_draft_only", "label": "Admin Panel Edits Limited to Drafts", "file_type": "concept", "source_file": "docs/v5-logic-changes.md", "source_location": "L40", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admin path could previously alter final assessments; now editing is draft-only and history revert is blocked."}, {"id": "docs_v5_logic_changes_retirement_evidence", "label": "Retirement Requires Path-Removal or Scope-Exit Evidence", "file_type": "concept", "source_file": "docs/v5-logic-changes.md", "source_location": "L41", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_v5_logic_changes_tie_break_priority", "label": "Equal-Score Work Priority (severity, customer reach, uncertainty)", "file_type": "concept", "source_file": "docs/v5-logic-changes.md", "source_location": "L42", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_v5_logic_changes_acceptance_expiry", "label": "Acceptance Expiry Status without Auto-Renewal", "file_type": "concept", "source_file": "docs/v5-logic-changes.md", "source_location": "L43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expired status, review task and persistent escalation notice are recorded; reminders derive from method-version parameters (30 and 7 days, proportional for shorter acceptance)."}, {"id": "docs_v5_logic_changes_periodic_review_and_triggers", "label": "Periodic Review & Trigger Monitoring", "file_type": "concept", "source_file": "docs/v5-logic-changes.md", "source_location": "L44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Periodic and annual reviews, evidence expiry, control failure, incident, change and new requirement create trackable tasks; deadlines of 1 business day for major incident/key control failure and 5 business days for new requirement/threat; shared control failure suspends its tests and opens reviews for related risks. Review periods read from the assessment's own method version."}, {"id": "docs_v5_logic_changes_internal_notices", "label": "Internal Notices & Escalation (no external messaging)", "file_type": "concept", "source_file": "docs/v5-logic-changes.md", "source_location": "L45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Internal notices for deadlines and escalation to authorised roles; repeated scheduler runs do not create duplicate notices; no email or external messages are sent."}, {"id": "docs_v5_logic_changes_management_report", "label": "Management Report (/reports/)", "file_type": "concept", "source_file": "docs/v5-logic-changes.md", "source_location": "L65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows risk counts per level from latest approved current assessment, critical-service coverage, overdue high/critical actions, problematic acceptances, key controls with valid E3, uncertainty/dependency concentration and level changes; no sums or averages of ordinal scores."}, {"id": "docs_v5_logic_changes_bc_table_over_examples", "label": "Implementation Decision: \u00a715 Bc Table over Conflicting Document Examples", "file_type": "rationale", "source_file": "docs/v5-logic-changes.md", "source_location": "L79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Following both the explicit table and examples that treat E3 as Bc=2 is impossible; the explicit \u00a715 rule is kept and example scores differ (e.g. EX01 target 8 -> 16 critical, \u00a717 example 8 -> 12 high)."}], "edges": [{"source": "docs_v5_logic_changes", "target": "docs_v5_logic_changes_datin_risk_management_v5_document", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/v5-logic-changes.md", "source_location": "L5", "weight": 1.0}, {"source": "docs_v5_logic_changes_e2_proven_limited_effect", "target": "docs_v5_logic_changes_control_credit_revalidation", "relation": "conceptually_related_to", "confidence":