{"nodes": [{"id": "apps_controls_templates_controls_control_assessment_form", "label": "control_assessment_form.html (Control Effectiveness Assessment Form)", "file_type": "document", "source_file": "apps/controls/templates/controls/control_assessment_form.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fieldset-grouped effectiveness form beside the control summary, the E level scale (Section 16) and the E conditions of the active method version."}, {"id": "apps_controls_templates_controls_control_assessment_form_e_level_conditions", "label": "Control effectiveness E-level conditions (Section 16)", "file_type": "rationale", "source_file": "apps/controls/templates/controls/control_assessment_form.html", "source_location": "L35-L50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "E2 and above: the control's real effect is proven by test evidence with method, result and sample rationale recorded; installation alone earns no reduction and a control without evidence is E1. E3 and above: adequate design, operating effectiveness, coverage at least the threshold, all critical points, no known gap, sample at least the threshold, and a verifier other than the control owner. E4: sustained operation over the review period. E5: additionally failure and bypass testing and continuous monitoring."}, {"id": "apps_controls_templates_controls_control_assessment_form_evidence_staleness", "label": "Control evidence staleness window", "file_type": "rationale", "source_file": "apps/controls/templates/controls/control_assessment_form.html", "source_location": "L49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evidence for a key control goes stale key_age days after the test ends, for other controls other_age days; a control with stale evidence counts only as E1 in Bc."}], "edges": [{"source": "apps_controls_views_controlassessmentformmixin", "target": "apps_controls_templates_controls_control_assessment_form", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/controls/templates/controls/control_assessment_form.html", "source_location": null, "weight": 1.0}, {"source": "apps_controls_templates_controls_control_assessment_form", "target": "templates_includes_field", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/controls/templates/controls/control_assessment_form.html", "source_location": "L19", "weight": 1.0}, {"source": "apps_controls_templates_controls_control_assessment_form_e_level_conditions", "target": "apps_controls_templates_controls_control_assessment_form", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/controls/templates/controls/control_assessment_form.html", "source_location": "L43-L50", "weight": 1.0}, {"source": "apps_controls_templates_controls_control_assessment_form_evidence_staleness", "target": "apps_controls_templates_controls_control_assessment_form", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/controls/templates/controls/control_assessment_form.html", "source_location": "L49", "weight": 1.0}], "hyperedges": [{"id": "control_effectiveness_feeds_path_bc", "label": "Control effectiveness E feeds path barrier Bc", "nodes": ["apps_controls_templates_controls_control_assessment_form_e_level_conditions", "apps_controls_templates_controls_control_assessment_form_evidence_staleness", "apps_assessments_templates_assessments_path_form_path_barrier_b", "apps_controls_templates_controls_control_assessment_form", "apps_controls_templates_controls_control_assessment_detail"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "apps/controls/templates/controls/control_assessment_form.html"}]}