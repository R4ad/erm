{"nodes": [{"id": "apps_reports_templates_reports_management", "label": "reports/management.html (management risk report)", "file_type": "code", "source_file": "apps/reports/templates/reports/management.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_reports_templates_reports_management_no_score_aggregation", "label": "Risk scores are never summed or averaged", "file_type": "rationale", "source_file": "apps/reports/templates/reports/management.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each risk is counted once using its latest approved current assessment; an unachieved target assessment never stands in for current."}, {"id": "apps_reports_templates_reports_management_critical_service_coverage_report", "label": "Critical service coverage (report definition)", "file_type": "rationale", "source_file": "apps/reports/templates/reports/management.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A critical service counts as covered only when all categories are reviewed AND every active risk of the service has a complete current assessment; stricter than the risk-universe page metric."}, {"id": "apps_reports_templates_reports_management_method_change_not_improvement", "label": "Score drop from method change is not control improvement", "file_type": "rationale", "source_file": "apps/reports/templates/reports/management.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Level changes across method versions are flagged; a lower score caused by a method change is not evidence of better controls, while same-method changes require checking assumptions and evidence."}], "edges": [{"source": "apps_reports_templates_reports_management", "target": "apps_reports_templates_reports_mana