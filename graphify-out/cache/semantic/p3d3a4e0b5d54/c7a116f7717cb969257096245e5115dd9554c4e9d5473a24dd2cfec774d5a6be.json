{"nodes": [{"id": "apps_actions_templates_actions_acceptance_detail", "label": "acceptance_detail.html (risk acceptance detail)", "file_type": "code", "source_file": "apps/actions/templates/actions/acceptance_detail.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "apps_actions_templates_actions_acceptance_detail_signature_workflow", "label": "Risk acceptance signature workflow", "file_type": "concept", "source_file": "apps/actions/templates/actions/acceptance_detail.html", "source_location": "L89-L148", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Draft is submitted for signing only when problems are cleared; the text is then locked so authorities sign exactly that text. Each authority row (risk owner, unit managers, senior management via official letter, committee via minutes) approves or rejects with reference/letter; acceptance can later be revoked with a reason."}, {"id": "apps_actions_templates_actions_acceptance_detail_no_auto_renewal", "label": "No automatic acceptance renewal", "file_type": "rationale", "source_file": "apps/actions/templates/actions/acceptance_detail.html", "source_location": "L19-L20,L43-L55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After the end date an acceptance is expired; there is no automatic renewal, so continuing requires a new acceptance (linked via renews) with all signatures again. A warning appears when 30 or fewer days remain."}, {"id": "apps_actions_templates_actions_acceptance_detail_validity_cap", "label": "Acceptance validity cap per decision level", "file_type": "concept", "source_file": "apps/actions/templates/actions/acceptance_detail.html", "source_location": "L51-L55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The decision level's acceptance_value and acceptance_unit cap the acceptance end date (shown as cap)."}, {"id": "apps_actions_templates_actions_acceptance_detail_silence_not_acceptance", "label": "Silence is not acceptance (section 25)", "file_type": "rationale", "source_file": "apps/actions/templates/actions/acceptance_detail.html", "source_location": "L60-L65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Silence, delayed response or lack of budget never counts as acceptance; a decision deadline is tracked and flagged when passed."}, {"id": "apps_actions_templates_actions_acceptance_detail_temporary_acceptance_rule", "label": "Temporary exceptional acceptance for plan-required levels (section 19)", "file_type": "rationale", "source_file": "apps/actions/templates/actions/acceptance_detail.html", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For decision levels where a treatment plan is mandatory, acceptance is only temporary and exceptional and is recorded alongside the treatment plan."}, {"id": "apps_actions_templates_actions_acceptance_detail_non_normal_acceptance", "label": "Non-normal acceptance (incomplete or low-confidence assessment)", "file_type": "concept", "source_file": "apps/actions/templates/actions/acceptance_detail.html", "source_location": "L36-L37", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When the assessment is incomplete or low-confidence the acceptance is not normal: it needs an evidence-collection deadline and temporary authorization from a higher authority; exceeded customer tolerance restricts general acceptance authority."}], "edges": [{"source": "apps_actions_templates_actions_acceptance_detail", "target": "apps_actions_templates_actions_includes_acceptance_status", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/actions/templates/actions/acceptance_detail.html", "source_location": "L8", "weight": 1.0}, {"source": "a