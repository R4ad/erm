{"nodes": [{"id": "apps_assessments_templates_assessments_impact_form", "label": "impact_form.html (Impact Profile Form)", "file_type": "document", "source_file": "apps/assessments/templates/assessments/impact_form.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Impact profile grid for one assessment: one card per affected party (Datin and each affected bank) and one row per impact dimension with level, actual value, unit, financial basis, rationale and evidence. Header shows service criticality, RTO, MTPD and financial basis; Datin's financial basis is approved operating revenue of the last 12 months, written on row F. Shows the system's suggested level per dimension."}, {"id": "apps_assessments_templates_assessments_impact_form_impact_profile_recording_rules", "label": "Impact profile recording rules", "file_type": "rationale", "source_file": "apps/assessments/templates/assessments/impact_form.html", "source_location": "L11-L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Level 0 means 'no impact' and needs a rationale. Missing data is recorded as 'Unknown' with a rationale, never as 0. From outage duration and loss amount the system suggests the S and F levels; choosing another level needs a rationale. Cells left 'not recorded' are not saved."}, {"id": "apps_assessments_templates_assessments_impact_form_provisional_s_floor", "label": "Provisional S floor without approved RTO/MTPD", "file_type": "rationale", "source_file": "apps/assessments/templates/assessments/impact_form.html", "source_location": "L55-L57", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For a critical service and a bank with no approved RTO or MTPD, the S (service) level must not be recorded below the provisional level unless there is a rationale and approval from the methodology custodian."}], "edges": [{"source": "apps_assessments_views_impactprofileview", "target": "apps_assessments_templates_assessments_impact_form", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/assessments/templates/assessments/impact_form.html", "source_location": null, "weight": 1.0}, {"source": "apps_assessments_templates_assessments_impact_form", "target": "apps_assessments_views_impactprofileview_build_groups", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "apps/assessments/templates/assessments/impact_form.html", "source_location": "L19", "weight": 1.0}, {"source": "apps_assessments_templates_assessments_impact_form_impact_profile_recording_rules", "target": "apps_assessments_templates_assessments_impact_form", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/assessments/templates/assessments/impact_form.html", "source_location": "L11-L14", "weight": 1.0}, {"source": "apps_assessments_templates_assessments_impact_form_provisional_s_floor", "target": "apps_assessments_templates_assessments_impact_form", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/assessments/templates/assessments/impact_form.html", "source_location": "L55-L57", "weight": 1.0}, {"source": "apps_assessments_templates_assessments_impact_form_provisional_s_floor", "target": "apps_catalog_templates_catalog_service_detail_service_bank_recovery_times", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "apps/assessments/templates/assessments/impact_form.html", "source_location": "L55", "weight": 1.0}, {"source": "apps_assessments_templates_assessments_impact_form", "target": "apps_catalog_templates_catalog_service_detail_service_bank_recovery_times", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "apps/assessments/templates/assessments/impa