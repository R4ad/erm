# این فایل را به ‎.env کپی کنید و مقدارها را تغییر دهید:  cp .env.example .env
# فایل ‎.env در git ثبت نمی‌شود؛ رمزها را فقط آنجا بنویسید.

# کلید امنیتی Django. برای سرور یک مقدار تصادفی و طولانی بسازید:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# نام‌های میزبانی که سامانه با آن‌ها باز می‌شود، با ویرگول جدا شوند.
ALLOWED_HOSTS=localhost,127.0.0.1

# تنظیمات کانتینر PostgreSQL (سرویس db در docker-compose.yml)
POSTGRES_DB=erm
POSTGRES_USER=erm
POSTGRES_PASSWORD=change-me

# آدرس اتصال Django به پایگاه داده، برای اجرای manage.py روی خود سیستم.
# نام کاربری، رمز و نام پایگاه باید با سه مقدار بالا یکی باشد.
# در اجرای کامل با Docker این مقدار خودکار با میزبان db جایگزین می‌شود.
DATABASE_URL=postgres://erm:change-me@localhost:5432/erm

# ماژول تنظیمات. manage.py به‌طور پیش‌فرض dev و wsgi/Docker به‌طور پیش‌فرض prod را برمی‌دارند.
# فقط اگر می‌خواهید پیش‌فرض را عوض کنید از حالت توضیح خارج کنید.
# DJANGO_SETTINGS_MODULE=config.settings.dev
