# این فایل را به ‎.env کپی کنید و مقدارها را تغییر دهید:  cp .env.example .env
# فایل ‎.env در git ثبت نمی‌شود؛ رمزها را فقط آنجا بنویسید.

# کلید امنیتی Django. برای سرور یک مقدار تصادفی و طولانی بسازید:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# نام‌های میزبانی که سامانه با آن‌ها باز می‌شود، با ویرگول جدا شوند.
ALLOWED_HOSTS=localhost,127.0.0.1

# تنظیمات کانتینر PostgreSQL (سرویس db در docker-compose.yml)
POSTGRES_DB=erm
POSTGRES_USER=erm
POSTGRES_PASSWORD=change-me

# آدرس اتصال Django به پایگاه داده، برای اجرای manage.py روی خود سیستم.
# نام کاربری، رمز و نام پایگاه باید با سه مقدار بالا یکی باشد.
# در اجرای کامل با Docker این مقدار خودکار با میزبان db جایگزین می‌شود.
DATABASE_URL=postgres://erm:change-me@localhost:5432/erm

# پشت nginx پروژه‌ی دیگری روی همان سرور که 80 و 443 و TLS را دارد (README، «پشت nginx دیگر»).
# در اجرای عادی هیچ‌کدام لازم نیست.
# COMPOSE_FILE=docker-compose.yml:docker/behind-proxy.yml
# FRONT_PROXY_NETWORK=other-project_default
# HTTP_BIND=127.0.0.1:8081
# BEHIND_HTTPS_PROXY=True
# CSRF_TRUSTED_ORIGINS=https://erm.example.local

# ماژول تنظیمات. manage.py به‌طور پیش‌فرض dev و wsgi/Docker به‌طور پیش‌فرض prod را برمی‌دارند.
# فقط اگر می‌خواهید پیش‌فرض را عوض کنید از حالت توضیح خارج کنید.
# DJANGO_SETTINGS_MODULE=config.settings.dev

# شناسایی هوشمند ریسک از پاسخنامه. mock بدون شبکه ریسک‌ها را از متن پاسخ‌ها می‌سازد (توسعه و تست).
# برای سرور داخلی سازگار با OpenAI (vLLM، Ollama): LLM_PROVIDER=openai_compatible و نشانی پایه تا ‎/v1.
# کلید را فقط در ‎.env بگذارید، نه در مخزن. سرویس ai در compose اجراهای صف را انجام می‌دهد.
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=60000
# گواهی HTTPS سرور LLM بررسی شود. false فقط برای سرور داخلی با گواهی خودامضا: هویت سرور ثابت نمی‌شود و کلید در
# برابر شنود میانی امن نیست. راه بهتر: گواهی CA داخلی را در کانتینر بگذارید و SSL_CERT_FILE را به آن بدهید.
LLM_VERIFY_SSL=true
# کمینه‌ی شباهت (۰ تا ۱) برای هشدار «مشابه ریسک موجود»؛ حداکثر ۳ ریسک نشان داده می‌شود.
RISK_SIMILARITY_THRESHOLD=0.3
